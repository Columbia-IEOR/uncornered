<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.uncornered.boston-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/niveditashainajnair/Developer/shooting viz/uncornered/phase2_pipeline/schedule/run_boston_refresh.sh</string>
    </array>

    <!-- 1st of every month at 9:00 AM. If the Mac is asleep then, it runs on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/niveditashainajnair/Developer/shooting viz/uncornered/phase2_pipeline/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/niveditashainajnair/Developer/shooting viz/uncornered/phase2_pipeline/logs/launchd.err.log</string>
</dict>
</plist>
